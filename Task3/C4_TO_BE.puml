    Container(booking_hk, "Booking Service", "Python / Java", "Создание и управление поездкой")
    Container(driver_hk, "Driver Service", "Python / Go", "Водители и доступность")
    Container(pricing_hk, "Pricing Service", "Python + ML", "Динамическое ценообразование")
    Container(payments_hk, "Payments Service", "Java", "Платежи и выплаты")

    ContainerDb(db_booking_hk, "Booking DB", "PostgreSQL", "Replica (HK)")
    ContainerDb(db_payments_hk, "Payments DB", "PostgreSQL", "Replica (HK)")

