@startuml Container_Diagram_ToBe_SEA_MultiRegion
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(passenger, "Пассажир")
Person(driver, "Водитель")

' ===================== Global Edge =====================
Container(global_dns, "Global DNS / Traffic Manager", "GeoDNS / Anycast","Геомаршрутизация пользователей и failover")
Container(global_waf, "Global WAF", "WAF / DDoS Protection","Защита от DDoS атак")

Rel(passenger, global_dns, "Использует")
Rel(driver, global_dns, "Использует")
Rel(global_dns, global_waf, "Геомаршрутизация")

' =====================================================
' =============== REGION: Singapore ===================
' =====================================================
System_Boundary(region_sg, "Регион: Сингапур") {

    Container(api_gateway_sg, "API Gateway", "Kong / Envoy", "Маршрутизация, Rate Limit")
    Container(firewall_sg, "Firewall", "Network Firewall", "Сетевая изоляция")

    ContainerQueue(kafka_sg, "Kafka Cluster", "Kafka", "Event Bus")

    Container(booking_sg, "Booking Service", "Python / Java", "Создание и управление поездкой")
    Container(driver_sg, "Driver Service", "Python / Go", "Водители и доступность")
    Container(pricing_sg, "Pricing Service", "Python + ML", "Динамическое ценообразование")
    Container(payments_sg, "Payments Service", "Java", "Платежи и выплаты")

    ContainerDb(db_booking_sg, "Booking DB", "PostgreSQL", "Primary (SG)")
    ContainerDb(db_payments_sg, "Payments DB", "PostgreSQL", "Primary (SG)")

    Rel(global_waf, firewall_sg, "HTTP/REST API")
    Rel(firewall_sg, api_gateway_sg, "")

    Rel(api_gateway_sg, booking_sg, "HTTP/REST API")

    Rel(booking_sg, driver_sg, "Проверяет доступность водителей", "HTTP/REST API")
    Rel(booking_sg, pricing_sg, "Запрашивает стоимость", "HTTP/REST API")
    Rel(booking_sg, payments_sg, "Инициирует платеж", "HTTP/REST API")

    Rel(booking_sg, kafka_sg, "Отправляет события")
    Rel(driver_sg, kafka_sg, "Отправляет события")
    Rel(pricing_sg, kafka_sg, "Отправляет события")
    Rel(payments_sg, kafka_sg, "Отправляет события")

    Rel(booking_sg, db_booking_sg, "Чтение/запись данных")
    Rel(payments_sg, db_payments_sg, "Чтение/запись данных")
}

