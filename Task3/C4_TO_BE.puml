' =====================================================
' =============== REGION: Hong Kong ===================
' =====================================================
System_Boundary(region_hk, "Регион: Гонконг") {

    Container(api_gateway_hk, "API Gateway", "Kong / Envoy", "Маршрутизация, Rate Limit")
    Container(firewall_hk, "Firewall", "Network Firewall", "Сетевая изоляция")

