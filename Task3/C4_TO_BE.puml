    Container(pricing_id, "Pricing Service", "Python + ML", "Динамическое ценообразование")
    Container(payments_id, "Payments Service", "Java", "Платежи и выплаты")

    ContainerDb(db_booking_id, "Booking DB", "PostgreSQL", "Primary (ID)")
    ContainerDb(db_payments_id, "Payments DB", "PostgreSQL", "Primary (ID)")

