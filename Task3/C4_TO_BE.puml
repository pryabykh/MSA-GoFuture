    Rel(driver_hk, kafka_hk, "Отправляет события")
    Rel(pricing_hk, kafka_hk, "Отправляет события")
    Rel(payments_hk, kafka_hk, "Отправляет события")

    Rel(booking_hk, db_booking_hk, "Чтение/запись данных")
    Rel(payments_hk, db_payments_hk, "Чтение/запись данных")
}

' =====================================================
' ========== Cross-Region Replication =================
' =====================================================

Rel(db_booking_sg, db_booking_id, "Репликация данных")
Rel(db_booking_id, db_booking_hk, "Репликация данных")

Rel(db_payments_sg, db_payments_id, "Репликация данных")
Rel(db_payments_id, db_payments_hk, "Репликация данных")

Rel(kafka_sg, kafka_id, "Репликация данных")
Rel(kafka_sg, kafka_hk, "Репликация данных")


@enduml
